# Backend base URL. Leave empty in development: the app uses the same host it
# loads the Metro bundle from (your computer's current LAN IP) on port 5000.
# Set it only for a deployed backend or when the backend runs on another machine.
EXPO_PUBLIC_API_URL=

# Supabase publishable (anon) key only. Never put the service role key here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Must match PHONE_LOGIN_EMAIL_DOMAIN in backend/.env.
EXPO_PUBLIC_PHONE_EMAIL_DOMAIN=phone.wildguard.example

# Shows the SMS simulator entry point used for the assignment demo.
EXPO_PUBLIC_DEMO_MODE=true
