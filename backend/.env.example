PORT=5000
NODE_ENV=development

# Supabase project (Project Settings > API). Server-only: never copy the service role key into mobile/.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

SUPABASE_STORAGE_BUCKET=incident-photos

# 5173 = the UC4 Park Manager web dashboard (web/, `npm run dev`).
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:5173

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

LOG_LEVEL=debug

# Mobile-number logins are mapped to <number>@<this domain> in Supabase Auth.
# Must match EXPO_PUBLIC_PHONE_EMAIL_DOMAIN in mobile/.env.
PHONE_LOGIN_EMAIL_DOMAIN=phone.wildguard.example

# Simulated SMS gateway (POST /api/v1/sms/simulate). Defaults to on outside production.
SMS_SIMULATOR_ENABLED=true

# Used only by `npm run seed:demo` to set the password of the demo accounts.
DEMO_USER_PASSWORD=

# MongoDB connection (Atlas or local)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/wildguard?retryWrites=true&w=majority
JWT_SECRET=your-secure-jwt-secret-at-least-32-chars

# Basemap tiles for the UC4 PDF hotspot map. Defaults to OpenStreetMap; set empty to turn off.
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
